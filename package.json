{
  "name": "hisaab",
  "version": "0.0.1",
  "private": true,
  "description": "Full-stack accounting & business management app for Indian SMBs",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:web": "cd apps/web && npx ng serve --open",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npx ng build",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "npx ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}

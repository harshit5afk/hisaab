<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    color: #1a1a1a;
    font-size: 11px;
    line-height: 1.4;
    padding: 0;
  }

  .invoice-page {
    width: 100%;
    padding: 24px 28px;
  }

  /* ─── Top header: Business + Customer ─── */
  .top-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
  }
  .business-info h1 {
    font-size: 18px;
    font-weight: 800;
    color: #111;
    margin-bottom: 2px;
  }
  .business-info p {
    font-size: 10px;
    color: #555;
    line-height: 1.4;
  }
  .customer-quick {
    text-align: right;
    font-size: 10.5px;
    color: #333;
  }
  .customer-quick strong {
    color: #555;
    font-weight: 600;
  }

  /* ─── Invoice title banner ─── */
  .invoice-title {
    background: #2980b9;
    color: #fff;
    text-align: center;
    padding: 7px 0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 0;
    border: 1px solid #2471a3;
  }

  /* ─── Details grid (Customer + Invoice meta) ─── */
  .details-grid {
    display: table;
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #999;
    border-top: none;
  }
  .details-grid .row {
    display: table-row;
  }
  .details-grid .cell {
    display: table-cell;
    padding: 3px 8px;
    border: 1px solid #bbb;
    font-size: 10px;
    vertical-align: top;
  }
  .details-grid .cell.label {
    font-weight: 700;
    color: #333;
    width: 70px;
    white-space: nowrap;
  }
  .details-grid .cell.value {
    color: #111;
  }
  .details-grid .section-header {
    display: table-cell;
    padding: 3px 8px;
    font-weight: 700;
    font-size: 9px;
    text-transform: uppercase;
    color: #555;
    letter-spacing: 0.5px;
    border: 1px solid #bbb;
    background: #f5f5f5;
  }

  /* ─── Items table ─── */
  .items-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: -1px;
  }
  .items-table thead th {
    background: #2980b9;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    padding: 6px 8px;
    border: 1px solid #2471a3;
    text-align: center;
  }
  .items-table thead th:nth-child(2) {
    text-align: left;
  }
  .items-table tbody td {
    padding: 5px 8px;
    border: 1px solid #bbb;
    font-size: 10.5px;
    vertical-align: top;
  }
  .items-table tbody td.num {
    text-align: center;
  }
  .items-table tbody td.amount {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .items-table tbody tr.item-row td {
    border-bottom: 1px solid #ddd;
  }
  .items-table tbody tr.empty-row td {
    height: 18px;
    border-bottom: 1px solid #e8e8e8;
  }

  /* ─── Totals row ─── */
  .items-table tfoot td {
    padding: 6px 8px;
    border: 1px solid #bbb;
    font-size: 10.5px;
    font-weight: 700;
  }
  .items-table tfoot td.amount {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* ─── Bottom section ─── */
  .bottom-section {
    border: 1px solid #bbb;
    border-top: none;
    display: table;
    width: 100%;
    border-collapse: collapse;
  }
  .bottom-row {
    display: table-row;
  }
  .bottom-cell {
    display: table-cell;
    border: 1px solid #bbb;
    padding: 5px 8px;
    font-size: 10px;
    vertical-align: top;
  }
  .bottom-cell.label {
    font-weight: 700;
    color: #333;
    background: #f5f5f5;
    white-space: nowrap;
  }
  .total-amount-cell {
    text-align: right;
    font-weight: 800;
    font-size: 12px;
    color: #111;
  }
  .total-amount-cell .eoe {
    display: block;
    font-size: 8.5px;
    font-weight: 400;
    color: #777;
    margin-top: 1px;
  }
  .amount-words {
    font-size: 9.5px;
    color: #333;
    text-transform: uppercase;
  }

  /* ─── Footer: Terms + Signatory ─── */
  .footer-section {
    display: table;
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #bbb;
    border-top: none;
    min-height: 90px;
  }
  .footer-row {
    display: table-row;
  }
  .footer-left {
    display: table-cell;
    width: 55%;
    padding: 8px 10px;
    border-right: 1px solid #bbb;
    font-size: 8.5px;
    color: #666;
    line-height: 1.5;
    vertical-align: top;
  }
  .footer-right {
    display: table-cell;
    width: 45%;
    padding: 8px 10px;
    text-align: center;
    vertical-align: bottom;
    font-size: 9.5px;
    color: #333;
  }
  .footer-right .certified {
    font-size: 8px;
    color: #777;
    margin-bottom: 8px;
  }
  .footer-right .for-label {
    font-weight: 700;
    font-size: 10px;
    margin-bottom: 30px;
    color: #111;
  }
  .footer-right .signatory {
    font-size: 9px;
    color: #555;
    border-top: 1px solid #999;
    display: inline-block;
    padding-top: 3px;
    min-width: 140px;
  }
</style>
</head>
<body>
  <div class="invoice-page">

    <!-- ─── Top header ─── -->
    <div class="top-header">
      <div class="business-info">
        <h1>{{businessName}}</h1>
        <p>{{businessAddress}}</p>
        <p>{{businessCity}}</p>
      </div>
      <div class="customer-quick">
        <div><strong>Name :</strong> {{customerName}}</div>
        <div><strong>Phone :</strong> {{customerPhone}}</div>
      </div>
    </div>

    <!-- ─── Invoice title banner ─── -->
    <div class="invoice-title">Invoice</div>

    <!-- ─── Details grid ─── -->
    <div class="details-grid">
      <div class="row">
        <div class="section-header" style="width: 50%;">Customer Detail</div>
        <div class="cell label">Invoice No.</div>
        <div class="cell value" style="width: 80px;">{{invoiceNo}}</div>
        <div class="cell label">Invoice Date</div>
        <div class="cell value">{{date}}</div>
      </div>
      <div class="row">
        <div class="cell">
          <table style="width: 100%; border: none; border-collapse: collapse;">
            <tr>
              <td style="width: 65px; font-weight: 700; padding: 2px 0; border: none; font-size: 10px;">Name</td>
              <td style="padding: 2px 4px; border: none; font-size: 10px;">{{customerName}}</td>
            </tr>
            <tr>
              <td style="font-weight: 700; padding: 2px 0; border: none; font-size: 10px;">Address</td>
              <td style="padding: 2px 4px; border: none; font-size: 10px;">{{customerAddress}}</td>
            </tr>
            <tr>
              <td style="font-weight: 700; padding: 2px 0; border: none; font-size: 10px;">Phone</td>
              <td style="padding: 2px 4px; border: none; font-size: 10px;">{{customerPhone}}</td>
            </tr>
            <tr>
              <td style="font-weight: 700; padding: 2px 0; border: none; font-size: 10px;">GSTIN</td>
              <td style="padding: 2px 4px; border: none; font-size: 10px;">{{customerGstin}}</td>
            </tr>
            <tr>
              <td style="font-weight: 700; padding: 2px 0; border: none; font-size: 10px;">Place of<br>Supply</td>
              <td style="padding: 2px 4px; border: none; font-size: 10px;">{{customerState}}</td>
            </tr>
          </table>
        </div>
        <div class="cell" colspan="4" style="color: #999; font-size: 9px;"></div>
        <div class="cell" style="color: #999; font-size: 9px;"></div>
        <div class="cell" style="color: #999; font-size: 9px;"></div>
        <div class="cell" style="color: #999; font-size: 9px;"></div>
      </div>
    </div>

    <!-- ─── Items table ─── -->
    <table class="items-table">
      <thead>
        <tr>
          <th style="width: 30px;">S.<br>No.</th>
          <th>Name of Product / Service</th>
          <th style="width: 70px;">HSN / SAC</th>
          <th style="width: 50px;">Qty</th>
          <th style="width: 80px;">Rate</th>
          <th style="width: 80px;">Total</th>
        </tr>
      </thead>
      <tbody>
        <tr class="item-row">
          <td class="num">1</td>
          <td>{{description}}</td>
          <td class="num"></td>
          <td class="num">1.00</td>
          <td class="amount">{{amount}}</td>
          <td class="amount">{{amount}}</td>
        </tr>
        <!-- Empty rows to fill the table area -->
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2" style="text-align: right; padding-right: 12px;">Total</td>
          <td></td>
          <td class="num" style="text-align: center; font-weight: 700;">1.00</td>
          <td></td>
          <td class="amount">{{totalAmount}}</td>
        </tr>
      </tfoot>
    </table>

    <!-- ─── Total in words + Amount ─── -->
    <div class="bottom-section">
      <div class="bottom-row">
        <div class="bottom-cell label" style="width: 90px;">Total in words</div>
        <div class="bottom-cell" style="width: 50%;">
          <span class="amount-words">{{amountInWords}}</span>
        </div>
        <div class="bottom-cell label">Total Amount</div>
        <div class="bottom-cell total-amount-cell">
          ₹{{totalAmount}}
          <span class="eoe">(E &amp; O.E.)</span>
        </div>
      </div>
    </div>

    <!-- ─── Footer: Terms + Signatory ─── -->
    <div class="footer-section">
      <div class="footer-row">
        <div class="footer-left">
          <div style="margin-bottom: 6px;">
            Subject to our home Jurisdiction.<br>
            Our Responsibility Ceases as soon as goods leaves our Premises.<br>
            Goods once sold will not taken back.<br>
            Delivery Ex-Premises.
          </div>
        </div>
        <div class="footer-right">
          <div class="certified">Certified that the particulars given above are true and correct.</div>
          <div class="for-label">For {{businessName}}</div>
          <br><br>
          <div class="signatory">Authorised Signatory</div>
        </div>
      </div>
    </div>

  </div>
</body>
</html>

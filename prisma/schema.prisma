generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers Customer[] @relation("CreatedBy")
  purchases Purchase[] @relation("PurchaseCreatedBy")

  @@map("users")
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  address   String?
  gstin     String?
  state     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  creator  User      @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  invoices Invoice[]
  payments Payment[]

  @@index([name])
  @@index([phone])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("customers")
}

model Invoice {
  id          String    @id @default(uuid())
  invoiceNo   String    @unique
  customerId  String
  date        DateTime
  amount       Int       // stored in paise — subtotal
  isGstInvoice Boolean   @default(false)
  taxRate      Float?    @default(18)
  cgst         Int       @default(0) // in paise
  sgst         Int       @default(0) // in paise
  igst         Int       @default(0) // in paise
  otherAmount  Int       @default(0) // in paise
  totalAmount  Int       @default(0) // amount + cgst + sgst + igst + otherAmount (in paise)
  description  String?
  items       Json?     // Array of line items [{name, hsn, qty, rate, total}]
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([customerId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@map("invoices")
}

model Purchase {
  id          String    @id @default(uuid())
  billNo      String?
  vendor      String
  date        DateTime
  amount      Int       // stored in paise
  description String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  creator User @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([vendor])
  @@index([date])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("purchases")
}

model Payment {
  id         String    @id @default(uuid())
  customerId String
  invoiceId  String?
  date       DateTime
  amount          Int       // stored in paise
  mode            String    @default("CASH")
  bankAccountName String?   // e.g. "Axis Bank", "SBI" — for BANK_TRANSFER / CHEQUE
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([invoiceId])
  @@index([date])
  @@index([deletedAt])
  @@map("payments")
}

model Product {
  id        String    @id @default(uuid())
  name      String
  hsn       String?
  unit      String    @default("NOS") // NOS, PCS, KG, LTR, MTR etc.
  rate      Int       // default selling rate in paise
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([deletedAt])
  @@map("products")
}

/// Atomic sequence for invoice number generation — avoids race conditions
model Sequence {
  id      String @id @default("invoice_seq")
  current Int    @default(0)

  @@map("sequences")
}
